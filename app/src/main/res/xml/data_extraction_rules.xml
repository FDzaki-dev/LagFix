<?xml version="1.0" encoding="utf-8"?>
<!-- v89: pengganti `allowBackup=false` untuk Android 12+ (lint DataExtractionRules). Semua data
     dikecualikan dari cloud backup & device-transfer = perilaku sama dgn sebelumnya (tak ada backup). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
