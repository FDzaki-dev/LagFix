<?xml version="1.0" encoding="utf-8"?>
<!-- v90: pasangan data_extraction_rules.xml untuk Android 11 ke bawah (lint DataExtractionRules: minSdk 26 < 31,
     jadi fullBackupContent wajib ikut ada). Semua data dikecualikan = perilaku sama dgn allowBackup=false. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
